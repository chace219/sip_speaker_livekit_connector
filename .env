# LiveKit Server Configuration (Local)
# For local development, using internal Docker network
LIVEKIT_URL=ws://livekit-server:7880

# API credentials - must match livekit-server-config.yaml keys section
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# For external access (web clients), use:
# LIVEKIT_URL=ws://localhost:7880
# or for production:
# LIVEKIT_URL=wss://your-domain.com
